{
  "name": "pocket-empires",
  "version": "1.0.0",
  "description": "Pocket Empires — Nostalgic Age-of-Empires inspired Daily 3-Minute Isometric RTS for Reddit (Devvit Web)",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "vite build --config src/client/vite.config.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server/index.cjs",
    "build": "npm run build:client && npm run build:server",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify:levels": "node scripts/verify-levels.mjs"
  },
  "dependencies": {
    "@devvit/analytics": "^0.15.4",
    "@devvit/public-api": "^0.15.4",
    "@devvit/web": "^0.15.4",
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@react-three/drei": "^9.114.6",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "devvit": "latest",
    "esbuild": "^0.25.9",
    "playwright-core": "^1.65.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
